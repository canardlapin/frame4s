#!/bin/sh
set -eu

expected_account=canardlapin
expected_alias=github-canardlapin
expected_identity="canardlapin <307091466+canardlapin@users.noreply.github.com>"
expected_remote="git@$expected_alias:canardlapin/frame4s.git"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(git -C "$script_dir" rev-parse --show-toplevel)
status=0

check_equal() {
  label=$1
  actual=$2
  expected=$3
  if test "$actual" = "$expected"; then
    printf 'ok   %-20s %s\n' "$label" "$actual"
  else
    printf 'fail %-20s expected %s; found %s\n' "$label" "$expected" "${actual:-unset}" >&2
    status=1
  fi
}

account=$(git -C "$repo_root" config --local --get github.account 2>/dev/null || true)
name=$(git -C "$repo_root" config --local --get user.name 2>/dev/null || true)
email=$(git -C "$repo_root" config --local --get user.email 2>/dev/null || true)
remote=$(git -C "$repo_root" remote get-url origin 2>/dev/null || true)

check_equal "GitHub account" "$account" "$expected_account"
check_equal "commit identity" "$name <$email>" "$expected_identity"
check_equal "origin" "$remote" "$expected_remote"

ssh_result=$(ssh -T "git@$expected_alias" 2>&1 || true)
case "$ssh_result" in
  *"Hi $expected_account!"*)
    printf 'ok   %-20s %s\n' "SSH authentication" "$expected_account"
    ;;
  *)
    printf 'fail %-20s %s\n' "SSH authentication" "$ssh_result" >&2
    status=1
    ;;
esac

if git -C "$repo_root" ls-remote origin >/dev/null 2>&1; then
  printf 'ok   %-20s reachable\n' "Git remote"
else
  printf 'fail %-20s unreachable\n' "Git remote" >&2
  status=1
fi

config_base=${XDG_CONFIG_HOME:-"$HOME/.config"}
profile_dir="$config_base/gh-$expected_account"
hosts_file="$profile_dir/hosts.yml"

auth_output=$(mktemp "${TMPDIR:-/tmp}/frame4s-gh-auth.XXXXXX")
token_output=$(mktemp "${TMPDIR:-/tmp}/frame4s-gh-token.XXXXXX")
api_output=$(mktemp "${TMPDIR:-/tmp}/frame4s-gh-api.XXXXXX")
trap 'rm -f "$auth_output" "$token_output" "$api_output"' EXIT HUP INT TERM

credential_store_unavailable=0
if "$script_dir/gh-repo" auth status >"$auth_output" 2>&1; then
  printf 'ok   %-20s valid\n' "GitHub API token"

  if api_account=$("$script_dir/gh-repo" api user --jq .login 2>"$api_output"); then
    check_equal "GitHub API account" "$api_account" "$expected_account"
  else
    printf 'fail %-20s request failed\n' "GitHub API account" >&2
    sed -n '1,8p' "$api_output" >&2
    status=1
  fi
elif ! "$script_dir/gh-repo" auth token >/dev/null 2>"$token_output" &&
    test -f "$hosts_file" &&
    grep -Fq "$expected_account:" "$hosts_file" &&
    grep -Fq "no oauth token found" "$token_output"; then
  printf 'unverified %-16s credential store unavailable to this process\n' "GitHub API token" >&2
  credential_store_unavailable=1
  status=1
else
  printf 'fail %-20s authentication check failed\n' "GitHub API token" >&2
  sed -n '1,8p' "$auth_output" >&2
  status=1
fi

if test "$credential_store_unavailable" -eq 1; then
  cat >&2 <<'EOF'

Git pushes use SSH and are independent of the gh API credential.
The isolated profile names canardlapin, but this process could not retrieve its
credential from the system store. Sandboxed processes commonly cannot read the
macOS Keychain even when the credential is present and valid.

Do not reauthenticate yet. Rerun tools/github/doctor with authorized Keychain
access. Reauthenticate only if that check also fails.
EOF
elif test "$status" -ne 0; then
  cat >&2 <<'EOF'

Git pushes use SSH and are independent of the gh API credential.
If this check was run with authorized Keychain access and the isolated
canardlapin API credential is invalid, repair only that profile with:

  tools/github/gh-repo auth login --hostname github.com --web --git-protocol ssh --skip-ssh-key

Then rerun tools/github/doctor.
EOF
fi

exit "$status"
